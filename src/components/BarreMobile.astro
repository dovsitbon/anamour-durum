---
import { SITE } from '../data/site';
---
<div class="md:hidden fixed inset-x-0 bottom-0 z-40 bg-charbon border-t border-[#3d332d] grid grid-cols-[1fr_auto] gap-2 p-2.5 pb-[max(.625rem,env(safe-area-inset-bottom))]">
  <a href={`tel:${SITE.telLien}`} class="btn btn-piment whitespace-nowrap !px-3">Appeler {SITE.telAffiche}</a>
  <a href={SITE.itineraire} class="btn btn-ligne" target="_blank" rel="noopener">Itinéraire</a>
</div>
